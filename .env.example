# Application Configuration
APP_NAME="Sistem Presensi QR Code"
APP_ENV=production
APP_KEY=change-me-long-random-secret
APP_DEBUG=false
APP_URL=https://your-domain.com

VAPID_SUBJECT=https://your-domain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presensi_qr
DB_USERNAME=root
DB_PASSWORD=

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
CORS_SUPPORTS_CREDENTIALS=true

# Laravel Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=your-domain.com,localhost,127.0.0.1
SANCTUM_GUARD=web

# QR Code Configuration
# Token Settings
QR_TOKEN_EXPIRY_MINUTES=60
QR_TOKEN_HASH_ALGORITHM=sha256
QR_TOKEN_RANDOM_LENGTH=32

# Encryption Settings
QR_HMAC_ALGORITHM=sha256
QR_SALT_LENGTH=64

# QR Code Generation Settings
QR_CODE_SIZE=300
QR_CODE_MARGIN=10
QR_ERROR_CORRECTION=M
QR_DEFAULT_FORMAT=png
QR_FOREGROUND_COLOR=000000
QR_BACKGROUND_COLOR=ffffff

# Logo Settings
QR_LOGO_ENABLED=true
QR_LOGO_PATH=img/logo_pkg.svg
QR_LOGO_WIDTH=60
QR_LOGO_HEIGHT=60
QR_LOGO_PUNCHOUT=true

# Payload Settings
QR_PAYLOAD_PREFIX=PKG
QR_PAYLOAD_VERSION=1
QR_PAYLOAD_DELIMITER=|

# Scan Settings
QR_MAX_SCANS_PER_DAY=2
QR_SCAN_COOLDOWN_SECONDS=60
QR_VALIDATE_LOCATION=false
QR_MAX_DISTANCE_METERS=100

# QR Rate Limiting
QR_RATE_LIMIT_SCAN=30
QR_RATE_LIMIT_GENERATE=10

# Rate Limiting
THROTTLE_LOGIN_ATTEMPTS=5
THROTTLE_LOGIN_DECAY=900
THROTTLE_QR_SCAN_ATTEMPTS=10
THROTTLE_QR_SCAN_DECAY=60

# File Upload Configuration
MAX_UPLOAD_SIZE=2048
ALLOWED_IMAGE_TYPES=jpeg,png,jpg,gif
QURAN_READING_SCAN_ENABLED=false

# Filesystem Configuration (Production)
# Set ini untuk production agar upload langsung ke public/storage
# tanpa perlu symlink
# Contoh: /home/username/public_html/storage
FILESYSTEM_PUBLIC_ROOT=

# Media Compression (Optional)
# Isi path ffmpeg.exe jika ingin voice note / video bukti dikompres otomatis
# Contoh Windows: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# CSRF
CSRF_SECRET=another-long-random-secret

# Mail Configuration (Optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Logging Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Cache / Session / Queue
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file

# Security Headers
SECURITY_HEADERS_ENABLED=true
CSP_ENABLED=true
HSTS_ENABLED=true

# PWA Configuration
PWA_NAME="Presensi QR"
PWA_SHORT_NAME="Presensi QR"
PWA_THEME_COLOR="#2563eb"
PWA_BACKGROUND_COLOR="#ffffff"
