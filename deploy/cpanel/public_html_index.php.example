<?php

use Illuminate\Contracts\Http\Kernel;
use Illuminate\Http\Request;

define('LARAVEL_START', microtime(true));

/*
|--------------------------------------------------------------------------
| cPanel public_html front controller
|--------------------------------------------------------------------------
|
| Pakai file ini jika source Laravel ada di folder seperti:
| /home/USERNAME/pkg
| dan web root aktif ada di:
| /home/USERNAME/public_html
|
| Penting:
| - __DIR__ akan menjadi public_path() aktif
| - Vite akan mencari manifest di /public_html/build/manifest.json
| - asset() dan public_path() akan sinkron ke public_html
|
*/

$appRoot = realpath(__DIR__ . '/../pkg');

if ($appRoot === false) {
    http_response_code(500);
    exit('Laravel app root tidak ditemukan.');
}

if (file_exists($maintenance = $appRoot . '/storage/framework/maintenance.php')) {
    require $maintenance;
}

require $appRoot . '/vendor/autoload.php';

$app = require_once $appRoot . '/bootstrap/app.php';
$app->usePublicPath(__DIR__);

$kernel = $app->make(Kernel::class);

$response = $kernel->handle(
    $request = Request::capture()
)->send();

$kernel->terminate($request, $response);
